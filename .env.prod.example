# Copie para ".env" na raiz do projeto NO SERVIDOR (nunca commite o .env
# real).
#
# Em produção o banco fica no MySQL do sistema (o mesmo acessível pelo
# phpMyAdmin em adbd.tuniku.com), não em container — então as
# credenciais do banco ficam apenas em api/.env. Este arquivo existe
# só para referência dos valores usados manualmente no deploy.

# Usado no comando do Certbot: certbot --nginx -d alertas.tuniku.com
CERTBOT_EMAIL=apmjuninho@gmail.com
