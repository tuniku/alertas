# Copie para ".env" na raiz do projeto NO SERVIDOR (nunca commite o .env
# real). O docker-compose.prod.yml lê essas variáveis automaticamente.

# Credenciais do MySQL em produção — gere senhas fortes, ex.: openssl rand -base64 24
DB_PASSWORD=troque-esta-senha
DB_ROOT_PASSWORD=troque-esta-senha-root

# Usado manualmente no comando do Certbot (não é lido pelo compose),
# só documentado aqui para referência: sudo certbot --nginx -d alertas.tuniku.com -m SEU_EMAIL
CERTBOT_EMAIL=apmjuninho@gmail.com
