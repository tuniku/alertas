APP_NAME=Alertas
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Credenciais compatíveis com o docker-compose.yml da raiz do projeto
# (rode "docker compose up -d" antes do primeiro "php artisan migrate").
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alertas
DB_USERNAME=alertas
DB_PASSWORD=alertas

# Para desenvolver sem MySQL/Docker, comente o bloco acima e use:
# DB_CONNECTION=sqlite
# (crie o arquivo com: touch database/database.sqlite)

SESSION_DRIVER=file
QUEUE_CONNECTION=database
CACHE_STORE=file
FILESYSTEM_DISK=local
