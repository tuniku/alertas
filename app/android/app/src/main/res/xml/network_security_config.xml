<?xml version="1.0" encoding="utf-8"?>
<!--
  A partir do Android 9 o tráfego HTTP sem TLS é bloqueado por padrão.
  Em produção isso é ótimo (a API é https), mas durante o desenvolvimento
  o app fala com o Laravel local em http://10.0.2.2:8000.

  Em vez de liberar HTTP para tudo (cleartextTrafficPermitted="true" no
  manifesto), a exceção fica restrita aos endereços de loopback do
  emulador. Assim o APK que vai para o celular continua incapaz de
  trafegar em texto claro para qualquer servidor da internet.

  10.0.2.2  -> o computador que hospeda o emulador
  10.0.3.2  -> equivalente no Genymotion
  localhost -> o próprio aparelho (túnel adb reverse, se um dia for usado)
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
